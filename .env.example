# ==============================================================================
# Gmail Automation MCP Server Configuration
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env, credentials.json, or token.json to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud & OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# Path to client_secrets.json downloaded from Google Cloud Console (Desktop App)
GMAIL_CREDENTIALS_PATH=./credentials.json

# Path to cached authorized user token (generated after running `python main.py --auth`)
GMAIL_TOKEN_PATH=./token.json

# Google Cloud Project details
GMAIL_CLOUD_PROJECT_NUMBER=542762227233
GMAIL_ACCOUNT_TYPE=personal

# ------------------------------------------------------------------------------
# Local SQLite Persistence & Sandboxed Storage
# ------------------------------------------------------------------------------
# Path to local SQLite WAL database (stores templates, scheduled jobs, ledger)
GMAIL_DB_PATH=./data/gmail_mcp.db

# Comma-separated list of directories allowed for reading/saving email attachments
GMAIL_ALLOWED_DIRS=./attachments,./data/downloads,./data/exports

# ------------------------------------------------------------------------------
# Quota & Rate Limits (Gmail REST API v1 Standards)
# ------------------------------------------------------------------------------
# Project quota (units per minute) - Google default is 1,200,000
GMAIL_PROJECT_QUOTA_PER_MINUTE=1200000

# Per-user quota (units per minute) - Google default is 6,000
GMAIL_USER_QUOTA_PER_MINUTE=6000

# Safety margin to subtract from quota limits (0.20 = 20% safety buffer)
GMAIL_QUOTA_SAFETY_MARGIN=0.20

# Personal Gmail Daily Sending Limits (Ceiling is 500/day)
GMAIL_DAILY_SEND_SOFT_CAP=200
GMAIL_DAILY_SEND_HARD_CAP=300

# Pacing and concurrency controls
GMAIL_SEND_CONCURRENCY=1
GMAIL_SEND_INTERVAL_SECONDS=3.0
GMAIL_READ_CONCURRENCY=3
GMAIL_WRITE_CONCURRENCY=2

# ------------------------------------------------------------------------------
# Optional Testing / Integration Overrides
# ------------------------------------------------------------------------------
# Set to 1 only when running live tests against an authenticated real mailbox
GMAIL_LIVE_E2E_ENABLED=0
GMAIL_ALLOWLISTED_RECIPIENT=
